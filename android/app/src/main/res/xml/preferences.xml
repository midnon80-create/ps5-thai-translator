<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory
        app:key="category_translator"
        app:title="ตัวแปลภาษาไทย (อังกฤษ → ไทย)">
        <SwitchPreference
            app:key="tr_enabled"
            app:defaultValue="true"
            app:title="เปิดตัวแปลภาษา"
            app:summary="แปลข้อความและเสียงพูดภาษาอังกฤษในเกมเป็นไทยขณะเล่น" />
        <ListPreference
            app:key="tr_mode"
            app:defaultValue="both"
            app:title="แปลอะไร"
            app:entries="@array/tr_mode_titles"
            app:entryValues="@array/tr_mode_values"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="tr_read_area"
            app:defaultValue="full"
            app:title="แปลอะไรบนจอ"
            app:entries="@array/tr_region_titles"
            app:entryValues="@array/tr_region_values"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="tr_position"
            app:defaultValue="above"
            app:title="ตำแหน่งคำแปล"
            app:entries="@array/tr_position_titles"
            app:entryValues="@array/tr_position_values"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="tr_font"
            app:defaultValue="sarabun"
            app:title="ฟอนต์"
            app:entries="@array/tr_font_titles"
            app:entryValues="@array/tr_font_values"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="tr_text_size"
            app:defaultValue="medium"
            app:title="ขนาดตัวอักษร"
            app:entries="@array/tr_size_titles"
            app:entryValues="@array/tr_size_values"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreference
            app:key="tr_show_english"
            app:defaultValue="false"
            app:title="แสดงภาษาอังกฤษใต้คำแปล"
            app:summary="ช่วยเช็กว่าอ่านข้อความถูกไหม" />
        <Preference
            app:key="tr_video_test"
            app:title="ทดสอบกับวิดีโอ"
            app:summary="เปิดไฟล์วิดีโอ (เช่น คลิปเกมที่มีซับอังกฤษจากแฟลชไดรฟ์) แล้วดูการแปลแบบเดียวกับตอนเล่น PS5">
            <intent
                android:targetPackage="com.ps5translate.tv"
                android:targetClass="com.metallic.chiaki.translate.VideoTestActivity" />
        </Preference>
        <Preference
            app:key="tr_check_update"
            app:title="เช็กอัปเดตแอป"
            app:summary="ดูว่ามีเวอร์ชันใหม่ไหม แล้วติดตั้งได้ในปุ่มเดียว">
            <intent
                android:targetPackage="com.ps5translate.tv"
                android:targetClass="com.metallic.chiaki.update.UpdateCheckActivity" />
        </Preference>
        <Preference
            app:key="tr_test"
            app:title="ทดสอบตัวแปล"
            app:summary="เช็กว่าอ่านซับ แปลไทย และฟังเสียงได้ครบ (ไม่ต้องเปิด PS5)">
            <intent
                android:targetPackage="com.ps5translate.tv"
                android:targetClass="com.metallic.chiaki.translate.TranslatorTestActivity" />
        </Preference>
        <Preference
            app:key="tr_buy"
            app:title="สมัครใช้งาน แปลด้วย Gemini"
            app:summary="ทดลองฟรี · รายปี · ตลอดชีพ — ดูสถานะการสมัคร"
            app:isPreferenceVisible="false" />
        <EditTextPreference
            app:key="tr_licence"
            app:title="รหัสไลเซนส์ (แปลด้วย Gemini)"
            app:dialogMessage="ใส่รหัสที่ได้จากผู้ขาย เช่น EYE-AB12-CD34 แล้วกดทดสอบตัวแปลเพื่อเช็ก"
            app:summary="ใส่รหัสจากผู้ขายเพื่อแปลด้วย Gemini (ลื่นและได้อารมณ์กว่า ต้องต่อเน็ต) ถ้าไม่ใส่จะแปลออฟไลน์" />
    </PreferenceCategory>

    <PreferenceCategory
        app:key="category_general"
        app:title="@string/preferences_category_title_general">
        <Preference
            app:key="registered_hosts"
            tools:summary="@string/preferences_registered_hosts_summary"
            app:summary=" "
            app:title="@string/preferences_registered_hosts_title"
            app:fragment="com.metallic.chiaki.settings.SettingsRegisteredHostsFragment"
            app:icon="@drawable/ic_console_simple"/>

        <SwitchPreference
            app:key="@string/preferences_swap_cross_moon_key"
            app:title="@string/preferences_swap_cross_moon_title"
            app:summary="@string/preferences_swap_cross_moon_summary"
            app:icon="@drawable/ic_gamepad" />

        <SwitchPreference
            app:key="@string/preferences_rumble_enabled_key"
            app:title="@string/preferences_rumble_enabled_title"
            app:summary="@string/preferences_rumble_enabled_summary"
            app:icon="@drawable/ic_rumble" />

        <SwitchPreference
            app:key="@string/preferences_motion_enabled_key"
            app:title="@string/preferences_motion_enabled_title"
            app:summary="@string/preferences_motion_enabled_summary"
            app:icon="@drawable/ic_motion" />

        <SwitchPreference
            app:key="@string/preferences_button_haptic_enabled_key"
            app:title="@string/preferences_button_haptic_enabled_title"
            app:summary="@string/preferences_button_haptic_enabled_summary"
            app:icon="@drawable/ic_button_haptic" />

        <SwitchPreference
            app:key="@string/preferences_log_verbose_key"
            app:title="@string/preferences_log_verbose_title"
            app:summary="@string/preferences_log_verbose_summary"
            app:icon="@drawable/ic_log" />

        <Preference
            app:key="logs"
            app:summary="@string/preferences_logs_summary"
            app:title="@string/preferences_logs_title"
            app:fragment="com.metallic.chiaki.settings.SettingsLogsFragment"
            app:icon="@drawable/ic_log"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:key="category_stream"
        app:title="@string/preferences_category_title_stream">
        <ListPreference
            app:key="@string/preferences_resolution_key"
            app:title="@string/preferences_resolution_title"
            app:summary="%s"
            app:icon="@drawable/ic_resolution"/>

        <ListPreference
            app:key="@string/preferences_fps_key"
            app:title="@string/preferences_fps_title"
            app:summary="%s"
            app:icon="@drawable/ic_fps"/>

        <EditTextPreference
            app:key="@string/preferences_bitrate_key"
            app:title="@string/preferences_bitrate_title"
            app:icon="@drawable/ic_bitrate"/>

        <ListPreference
            app:key="@string/preferences_codec_key"
            app:title="@string/preferences_codec_title"
            app:summary="%s"
            app:icon="@drawable/ic_codec"/>
    </PreferenceCategory>

    <PreferenceCategory
        app:key="category_export"
        app:title="@string/preferences_category_title_export">
        <Preference
            app:key="@string/preferences_export_settings_key"
            app:summary="@string/preferences_export_settings_summary"
            app:title="@string/preferences_export_settings_title"
            app:icon="@drawable/ic_export"/>

        <Preference
            app:key="@string/preferences_import_settings_key"
            app:summary="@string/preferences_import_settings_summary"
            app:title="@string/preferences_import_settings_title"
            app:icon="@drawable/ic_import"/>
    </PreferenceCategory>
</PreferenceScreen>