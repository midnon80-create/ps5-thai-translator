<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Google Play: apps may not install other APKs or update themselves -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <!-- Play restricts media permissions; the video test uses the system file picker instead -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <!-- HDMI 4K mode: Thai drawn over the TV's HDMI input. No foreground service here: while the Thai window is on
         screen Android keeps the app running (an app showing an overlay counts as in use). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <application>
        <service
            android:name="com.metallic.chiaki.hdmi.HdmiModeService"
            android:exported="false" />
    </application>
</manifest>
